# MongoDB — set automatically by docker-compose, but can be overridden
# MONGODB_URI=mongodb://mongo:27017/maqder

# Server
NODE_ENV=production
PORT=3000

# JWT
JWT_SECRET=change-this-to-a-long-random-string

# Frontend URL (used by CORS and email links)
FRONTEND_URL=https://maqder.com

# JSON body size limit (default 2mb; raise only for specific upload-heavy deployments)
# JSON_BODY_LIMIT=2mb

# Demo @test.com / password123 tenant auto-create (disabled in production unless true)
# ALLOW_DEMO_LOGIN=false

# Open /api/auth/register without tenantSlug (disabled in production; creates viewer under slug only)
# ALLOW_OPEN_REGISTER=false

# ZATCA / E-invoicing
ZATCA_MODE=production
# Required in production for /api/webhooks/zatca
# ZATCA_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API app secret (required for POST /api/whatsapp/webhook)
# WHATSAPP_APP_SECRET=

# Email inbound webhook (required in production)
# EMAIL_INBOUND_WEBHOOK_SECRET=

# Cron: set CRON_WORKER=1 on exactly one process; CRON_WORKER=0 on API replicas
# CRON_WORKER=0

# Redis (required for ready checks / shared rate limits when enabled)
# REDIS_URL=redis://localhost:6379
# REDIS_ENABLED=true

# Object storage for uploads (preferred over local disk for multi-node)
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=

# Email SMTP (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Cloud storage for backups and uploads (optional)
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=

# WhatsApp / other integrations (optional)

# Cloudflare OAuth for tenant domain auto-DNS (optional)
# Register an OAuth app at https://dash.cloudflare.com/profile/api-tokens to obtain these
# CLOUDFLARE_OAUTH_CLIENT_ID=your_cloudflare_oauth_client_id
# CLOUDFLARE_OAUTH_CLIENT_SECRET=your_cloudflare_oauth_client_secret
# CLOUDFLARE_FALLBACK_ORIGIN=origin.maqder.com

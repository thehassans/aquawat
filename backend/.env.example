# ===========================================
# ZATCA ERP - Environment Variables
# ===========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local: mongodb://localhost:27017/zatca-erp
# Compose replica set: mongodb://mongo:27017,mongo-secondary:27017/maqder?replicaSet=rs0
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/zatca-erp
# Writes stay on primary. Stats/dashboard/VAT use secondaryPreferred when a replica exists.
# MONGODB_READ_PREFERENCE=primary
# MONGODB_STATS_READ_PREFERENCE=secondaryPreferred
# Atlas Search index name (auto invoices_search when URI contains mongodb.net). Set false to disable.
# ATLAS_SEARCH_INDEX=invoices_search
# Set true after enabling Atlas Continuous Cloud Backup (PITR) in the Atlas UI.
# ATLAS_PITR=false

# JWT Configuration (min 32 chars in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32
JWT_EXPIRE=24h

# Frontend URL (for CORS in production)
# Multiple origins can be comma-separated in production
FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=1
# Only enable if your edge proxy strips client-spoofed X-Forwarded-Host
TRUST_FORWARDED_HOST=false

# Redis (recommended for multi-worker rate limits / Socket.IO / cron election)
# REDIS_URL=redis://localhost:6379

# Object storage (required for multi-replica SaaS; local disk is single-node only)
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_PUBLIC_URL=
# ALLOW_LOCAL_UPLOADS=true
# REQUIRE_OBJECT_STORAGE=false

# Separate encryption key for ZATCA private keys (falls back to JWT_SECRET)
# ZATCA_KEY_ENCRYPTION_KEY=

# Rate limits (per IP / 15 min window)
# API_RATE_LIMIT_MAX=2000
# PUBLIC_RATE_LIMIT_MAX=1200
# AUTH_RATE_LIMIT_MAX=40

# Cluster / workers
# CLUSTER_WORKERS=2
# CRON_WORKER=0
# WORKER_ID=1
# Dedicated PDF worker: API only enqueues. Run: npm run worker:pdf
# PDF_WORKER_DEDICATED=false
# PDF_WORKER_CONCURRENCY=1

# Database resilience
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_RECONNECT_INTERVAL_MS=5000

# OpenAI API Key (optional - for AI features)
OPENAI_API_KEY=your-openai-api-key

# ZATCA API Configuration
# Sandbox: https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
# Production: https://gw-fatoora.zatca.gov.sa/e-invoicing/core
ZATCA_API_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
ZATCA_COMPLIANCE_CSID=
ZATCA_PRODUCTION_CSID=

# Email Configuration (for alerts/notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Super Admin Credentials (for initial setup — use a strong unique password in production)
SUPER_ADMIN_EMAIL=admin@maqder.com
SUPER_ADMIN_PASSWORD=ChangeMeToAStrongPassword!
